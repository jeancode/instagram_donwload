{
  "manifest_version": 3,
  "name": "Instagram Media & Stories Downloader",
  "version": "1.0.0",
  "description": "Descarga historias, reels, fotos y videos de Instagram con un solo clic.",
  "icons": {
    "16": "icons/icon@16.png",
    "48": "icons/icon@48.png",
    "128": "icons/icon@128.png"
  },
  "action": {
    "default_icon": "icons/icon@16.png",
    "default_title": "Descargar de Instagram"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["downloads"]
}
